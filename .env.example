# === Supabase ===
# Panel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key: SOLO se usa en el servidor (webhooks, scripts de seed). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Kushki (pasarela para Ecuador) ===
# Si se configura, REEMPLAZA a Stripe en el checkout de la tienda (paga directo a banco ecuatoriano).
# Panel Kushki > Credenciales
NEXT_PUBLIC_KUSHKI_PUBLIC_MERCHANT_ID=
KUSHKI_PRIVATE_MERCHANT_ID=
# "production" para cobros reales, cualquier otro valor usa el entorno de pruebas (UAT)
NEXT_PUBLIC_KUSHKI_ENV=uat

# === PayPhone (pasarela para Ecuador, alternativa a Kushki) ===
# Prioridad de checkout: Kushki > PayPhone > Stripe (usa el primero que esté configurado)
# Panel PayPhone > Desarrolladores/API
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=

# === Stripe (se usa solo si Kushki/PayPhone no están configurados) ===
# Panel Stripe > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Panel Stripe > Developers > Webhooks > tu endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# === Chatbot (Google Gemini, nivel gratuito) ===
# Genera tu clave gratis en https://aistudio.google.com/apikey (no pide tarjeta)
GEMINI_API_KEY=

# === Formulario de contacto (Resend, nivel gratuito) ===
# Genera tu clave en https://resend.com/api-keys (gratis, sin tarjeta)
RESEND_API_KEY=
# Correo donde quieres recibir los mensajes del formulario de contacto
CONTACT_EMAIL=

# === Negocio ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Teléfono/correo visibles en la barra superior y el footer de la tienda (déjalos vacíos hasta confirmarlos)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
# Número de WhatsApp para el botón flotante y checkout (formato 593999999999, sin +). Vacío = botón oculto.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# === Redes sociales (se muestran en la barra superior y el footer; vacío = ícono deshabilitado) ===
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/ComecsaMegaStore
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/comecsa.ec/
NEXT_PUBLIC_SOCIAL_TIKTOK=https://www.tiktok.com/@comecsa
NEXT_PUBLIC_SOCIAL_TWITTER=
